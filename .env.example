OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_SEARCH_MODEL=gpt-4o
TAVILY_API_KEY=
SERPER_API_KEY=
# Serper free tier (~2500/mo) — used ONLY for historical training/eval, not live alerts
SERPER_MONTHLY_LIMIT=2500
# --- Dashboard login (set on first visit or via env bootstrap) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
AUTH_DISABLED=false

# --- Email alerts ---
ALERT_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Elentrx Alerts <you@gmail.com>
SMTP_USE_TLS=true

FAVORABILITY_THRESHOLD=0.65
WATCHLIST_CACHE_HOURS=24
WATCHLIST_MAX_TRIALS=10
WATCHLIST_LLM_MODEL=gpt-4o-mini
SNAPSHOT_DB_PATH=data/snapshots.db
CTGOV_PAGE_SIZE=100
CTGOV_MAX_PAGES=20
