OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_SEARCH_MODEL=gpt-4o
TAVILY_API_KEY=
SERPER_API_KEY=
# Serper free tier (~2500/mo) — used ONLY for historical training/eval, not live alerts
SERPER_MONTHLY_LIMIT=2500
# --- Dashboard login (set on first visit or via env bootstrap) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
AUTH_DISABLED=false
ALLOW_SIGNUP=true
# Required for Create account (case-insensitive). New users unlock signup with this code;
# their email is subscribed to favorable trial-hit alerts.
ACCESS_CODE=FOXFAM

# --- Email alerts (pick ONE method) ---
ALERT_EMAIL=

# Option A: Gmail SMTP (needs 16-char App Password, NOT login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Elentrx Alerts <you@gmail.com>
SMTP_USE_TLS=true

# Option B: Resend API (easier — free at resend.com, no app passwords)
# RESEND_API_KEY=re_...
# RESEND_FROM=Elentrx <onboarding@resend.dev>

FAVORABILITY_THRESHOLD=0.65
WATCHLIST_CACHE_HOURS=24
WATCHLIST_MAX_TRIALS=10
WATCHLIST_LLM_MODEL=gpt-4o-mini
SNAPSHOT_DB_PATH=data/snapshots.db
CTGOV_PAGE_SIZE=100
CTGOV_MAX_PAGES=20
